  "actions": [
    {
      "key": "search_source",
      "label": {
        "en": "Find a source",
        "fr": "Trouver une source",
        "de": "Quelle suchen",
        "es": "Buscar una fuente"
      },
      "description": {
        "en": "Search the sources by town, operator or country, and get the source and arguments to copy.",
        "fr": "Cherche parmi les sources par commune, organisme ou pays, et donne la source et les arguments à recopier.",
        "de": "Durchsucht die Quellen nach Ort, Entsorger oder Land und liefert Quelle und Argumente zum Übernehmen.",
        "es": "Busca entre las fuentes por municipio, operador o país, y da la fuente y los argumentos que debe copiar."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "label": {
            "en": "Town, operator or country",
            "fr": "Commune, organisme ou pays",
            "de": "Ort, Entsorger oder Land",
            "es": "Municipio, operador o país"
          },
          "placeholder": { "en": "Bordeaux", "fr": "Bordeaux", "de": "Bordeaux", "es": "Bordeaux" },
          "required": true
        }
      ]
    },
    {
      "key": "test_sources",
      "label": {
        "en": "Test the schedules",
        "fr": "Tester les calendriers",
        "de": "Abfuhrpläne testen",
        "es": "Probar los calendarios"
      },
      "description": {
        "en": "Ask every configured source now (save the configuration first) and show what it returns.",
        "fr": "Interroge maintenant chaque source configurée (enregistrez d’abord la configuration) et affiche ce qu’elle renvoie.",
        "de": "Fragt jetzt jede eingerichtete Quelle ab (Konfiguration zuerst speichern) und zeigt, was sie liefert.",
        "es": "Consulta ahora cada fuente configurada (guarde antes la configuración) y muestra lo que devuelve."
      },
      "timeout_seconds": 120
    }
  ],
